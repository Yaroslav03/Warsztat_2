<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="C:/Users/yaros/Desktop/Warsztat_2/Warsztat_2/Warsztat_2/WarehouseCar.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="0"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2641"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="0" parent="0"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><current_table name="4,9:mainDaneFirmy"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="DaneFirmy" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="40"/><column index="2" value="93"/><column index="3" value="90"/><column index="4" value="40"/><column index="5" value="86"/><column index="6" value="43"/><column index="7" value="113"/><column index="8" value="57"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_"><sort/><column_widths><column index="1" value="43"/><column index="2" value="40"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1">-- Таблиця для клієнтів
CREATE TABLE Klienty (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    Imię TEXT NOT NULL,
    Nazwisko TEXT NOT NULL,
    NrTelefonu TEXT NOT NULL,
    AdresFirmy TEXT,
    NIP TEXT,
    VIN TEXT
);

-- Таблиця для автомобілів
CREATE TABLE Samochód (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    Marka TEXT NOT NULL,
    Model TEXT NOT NULL,
    Silnik TEXT NOT NULL,
    RokProdukcji TEXT NOT NULL,
    VIN TEXT NOT NULL UNIQUE
);

-- Таблиця для зберігання історії володіння автомобілями
CREATE TABLE OwnershipHistory (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    ID_власника INTEGER NOT NULL,
    ID_авто INTEGER NOT NULL,
    Дата_початку TEXT NOT NULL,
    Дата_кінця TEXT,
    FOREIGN KEY (ID_власника) REFERENCES Klienty(ID),
    FOREIGN KEY (ID_авто) REFERENCES Samochód(ID)
);

-- Таблиця для історії ремонтів
CREATE TABLE HistoriaNapraw (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    DataPrzyjęcia TEXT NOT NULL,
    NrRejestracji TEXT,
    Przebieg INTEGER,
    DokumentySamochodu TEXT,
    KluczykiSamochodu TEXT,
    TestDrive TEXT,
    Zlecenie TEXT,
    Diagnostyka TEXT,
    Naprawa TEXT,
    VIN TEXT NOT NULL,
    FOREIGN KEY (VIN) REFERENCES Samochód(VIN)
);

-- Таблиця для працівників
CREATE TABLE Pracownicy (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    Imie TEXT NOT NULL,
    Stanowisko TEXT NOT NULL,
    Telefon TEXT NOT NULL
);

-- Таблиця для запчастин (склад)
CREATE TABLE Magazyn (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    Typ TEXT NOT NULL,
    Nazwa TEXT NOT NULL,
    NumerCzęści TEXT NOT NULL,
    Opis TEXT,
    Cena NUMERIC NOT NULL,
    Ilość INTEGER NOT NULL,
    Suma NUMERIC NOT NULL
);

-- Таблиця для управління замовленнями
CREATE TABLE ZarządzanieZleceniami (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    VIN TEXT NOT NULL,
    Przyjęty TEXT,
    OczekujeNaOdbiór TEXT,
    DataPrzyjęcie TEXT,
    DataOczekiwaniaOdbioru TEXT,
    DataPłatności TEXT,
    MetodaPłatności TEXT,
    KosztSzacunkowy NUMERIC,
    KosztKońcowy NUMERIC,
    KosztZMarżą NUMERIC,
    KosztCałkowityCzęści NUMERIC,
    WykonanaPraca TEXT,
    WykonawcaPracy TEXT,
    FOREIGN KEY (VIN) REFERENCES Samochód(VIN)
);

-- Таблиця для запланованих автомобілів (заплановані ремонти)
CREATE TABLE ZaplanowaneSamochody (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    Imię TEXT NOT NULL,
    Nazwisko TEXT NOT NULL,
    Marka TEXT NOT NULL,
    Model TEXT NOT NULL,
    Problem TEXT NOT NULL,
    Telefon TEXT NOT NULL,
    DataPrzyjęcia TEXT NOT NULL
);

-- Таблиця для зберігання даних фірм
CREATE TABLE DaneFirmy (
    ID INTEGER PRIMARY KEY AUTOINCREMENT,
    NazwaFirmy TEXT NOT NULL,
    AdresFirmy TEXT NOT NULL,
    NIP TEXT NOT NULL,
    NrTelefonu TEXT NOT NULL,
    BDO TEXT NOT NULL,
    KontoBankowe TEXT NOT NULL,
    Marża INTEGER NOT NULL
);
</sql><current_tab id="0"/></tab_sql></sqlb_project>
